# No API keys are required — everything uses free, keyless services by default.
# Copy to .env only if you want to override a default.

# Routing server used when a leg is not in the snapshot (default: the public OSRM demo server).
# Point this at a self-hosted OSRM (https://github.com/Project-OSRM/osrm-backend) for heavy use.
VITE_OSRM_URL=

# MapLibre style URL (default: OpenFreeMap "liberty", free and keyless).
# e.g. https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE=
