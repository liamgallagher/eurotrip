{
  "name": "eurotrip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "data:countries": "tsx scripts/build-countries.ts",
    "data:legs": "tsx scripts/build-legs.ts",
    "data:check": "tsx scripts/check-legs.ts",
    "data:chargers": "tsx scripts/build-chargers.ts",
    "data:holidays": "tsx scripts/build-holidays.ts",
    "data:photos": "tsx scripts/build-photos.ts",
    "data:metrics": "tsx scripts/build-metrics.ts",
    "data:all": "npm run data:countries && npm run data:chargers && npm run data:holidays && npm run data:photos && npm run data:legs && npm run data:check && npm run data:metrics",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "data:photos:download": "tsx scripts/download-photos.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mapbox/polyline": "^1.2.1",
    "@turf/along": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "idb-keyval": "^6.3.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
